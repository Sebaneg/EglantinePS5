@@ -148,6 +148,33 @@ void TextureCache<P>::RunGarbageCollector() {
             return value != nullptr ? std::strtoull(value, nullptr, 10) : 0ULL;
         }();
         ticks_to_destroy = (std::max)(ticks_to_destroy, min_age);
+        // The ages above are frames: at title 1's 10-15 frames a second in a race, 10 frames is
+        // under a second, and the collector deleted the textures of what had just left the
+        // screen (79249 images made and 78310 deleted in 12 minutes, 53003 of them costly ASTC
+        // to decode again, with flashes as they came back). Images used in the last
+        // EDEN_NX2_TC_KEEP_MS (default 2000; 0: off) stay, unless device memory is past the
+        // critical threshold by EDEN_NX2_TC_KEEP_SLACK_MIB (default 512) or more.
+        static const auto keep_time = std::chrono::milliseconds([] {
+            const char* value = std::getenv("EDEN_NX2_TC_KEEP_MS");
+            return static_cast<long long>(value != nullptr ? std::strtoull(value, nullptr, 10)
+                                                           : 2000ULL);
+        }());
+        static const u64 keep_slack = [] {
+            const char* value = std::getenv("EDEN_NX2_TC_KEEP_SLACK_MIB");
+            return (value != nullptr ? std::strtoull(value, nullptr, 10) : 512ULL) << 20;
+        }();
+        if (keep_time.count() != 0 && total_used_memory < critical_memory + keep_slack) {
+            const auto since = std::chrono::steady_clock::now() - keep_time;
+            u64 recent = 0;
+            while (recent < frame_tick && recent < frame_starts.size() &&
+                   frame_starts[(frame_tick - 1 - recent) % frame_starts.size()] >= since) {
+                ++recent;
+            }
+            if (recent > ticks_to_destroy) {
+                ticks_to_destroy = recent;
+                ++gc_kept_recent;
+            }
+        }
         num_iterations = aggressive_mode ? 40 : (high_priority_mode ? 20 : 10);
     };
     const auto Cleanup = [this, &num_iterations, &high_priority_mode, &aggressive_mode,
