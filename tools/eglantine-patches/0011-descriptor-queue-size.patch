 namespace Vulkan {
 
+namespace {
+// EDEN_DESCRIPTOR_QUEUE_DIV=N (1 to 8): each frame's descriptor payload is 1/N of its size. The
+// guest queue's eight frames of 0x80000 entries are 96 MiB of the pool the CPU shares with the GPU
+// on the PS5; a frame that fills a smaller one waits for the worker and starts it again.
+size_t ScaledPayload(size_t size) {
+    const char* value = std::getenv("EDEN_DESCRIPTOR_QUEUE_DIV");
+    const unsigned long divisor = value != nullptr ? std::strtoul(value, nullptr, 10) : 1;
+    return divisor >= 1 && divisor <= 8 ? size / divisor : size;
+}
+} // namespace
