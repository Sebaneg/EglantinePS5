-// Read once at startup: Enabled() runs several times per method write (no guard to check).
-inline const bool g_enabled = std::getenv("EDEN_NX2_GPU_PROFILE") != nullptr;
+// Read once, when the GPU thread first asks: by then the frontend may have set it (EglantinePS5's
+// lab file, medir=on), which a read at program start missed. Enabled() runs several times per
+// method write: one relaxed load once it is known.
+inline std::atomic<int> g_enabled{-1};
 
 inline bool Enabled() {
-    return g_enabled;
+    int enabled = g_enabled.load(std::memory_order_relaxed);
+    if (enabled < 0) {
+        enabled = std::getenv("EDEN_NX2_GPU_PROFILE") != nullptr ? 1 : 0;
+        g_enabled.store(enabled, std::memory_order_relaxed);
+    }
+    return enabled != 0;
 }
 
