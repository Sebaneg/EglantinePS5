 constexpr u32 CANARY_VALUE = 0xDEADBEEF;
 
+// EDEN_FIBER_STACK_KIB=N (256 to 2048): each fiber's stack. Heap memory is real from the first
+// byte on the PS5, and title 1's 151 guest threads held 302 MiB of 2 MiB stacks, spread over the
+// heap's spaces so that none of them emptied and went back. Read for each fiber: a lab line
+// applies from the next game.
+static size_t FiberStackSize() {
+    const char* value = std::getenv("EDEN_FIBER_STACK_KIB");
+    const unsigned long kib = value != nullptr ? std::strtoul(value, nullptr, 10) : 0;
+    if (kib < 256 || kib > 2048) {
+        return DEFAULT_STACK_SIZE;
+    }
+    return static_cast<size_t>(kib) * 1024;
+}
