+    // EDEN_NX2_GPU_ONLY_TILES=1: a GPU-only region of 1 GiB or more that is backed as it is written
+    // (title 1's texture pools at 0x84_3023_0000, 5.8 GB, and 0x85_9afb_0000, 1.4 GB) takes the
+    // game's tiles (216) the way a sparse region does: its device pages show the game's memory, and
+    // writes outside the tiles are dropped. Without it those maps are left out, and the 2D blits
+    // that fill the pools as the intro starts got blocks of their own, 4 MiB each: 1.3 GB on top of
+    // the game's memory behind the same tiles. Render targets (285 MB regions) are never taken.
+    static bool GpuOnlyTiles() {
+        static const bool on = [] {
+            const char* value = std::getenv("EDEN_NX2_GPU_ONLY_TILES");
+            return value != nullptr && value[0] == '1';
+        }();
+        return on;
+    }
+    // EDEN_NX2_GPU_ONLY_TILES_MIB=N: the smallest region that takes them (MiB, 1024 without it).
+    // Title 1 also has a 341 MiB GPU-only pool whose whole-image upload needed a 352 MiB staging
+    // buffer as the race loaded; 300 takes it and still leaves out the 285 MB render targets.
+    // Values under 286 are not taken, so render targets never are.
+    static u64 GpuOnlyTilePoolSize() {
+        static const u64 size = [] {
+            const char* value = std::getenv("EDEN_NX2_GPU_ONLY_TILES_MIB");
+            const u64 mib = value != nullptr ? std::strtoull(value, nullptr, 10) : 0;
+            return (mib >= 286 ? mib : 1024ULL) << 20;
+        }();
+        return size;
+    }
