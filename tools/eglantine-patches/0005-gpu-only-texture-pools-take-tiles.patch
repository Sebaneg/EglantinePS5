+    // Whether the GPU-only region at `start` takes the game's tiles; the first time it does, the
+    // texture cache learns it as a sparse region (with the blocks written so far), so that images
+    // over it read the tiles and get sparse storage.
+    bool TakesGpuOnlyTiles(u64 start, SparseRegion& region) {
+        if (!region.gpu_only || !GpuOnlyTiles() || region.size < GpuOnlyTilePoolSize()) {
+            return false;
+        }
+        if (!region.tile_pool) {
+            region.tile_pool = true;
+            Tegra::Nx2SparseRegionCreated(start, region.size, SparseBlockSize);
+            for (u64 block = 0; block < region.blocks.size(); ++block) {
+                if (region.blocks[block] != BlockEmpty) {
+                    Tegra::Nx2SparseBlockWritten(start, block);
+                }
+            }
+            LOG_INFO(Service, "nx2:gpu GPU-only region at {:#x} ({} MiB) takes the game's tiles",
+                     start, region.size >> 20);
+        }
+        return true;
+    }
