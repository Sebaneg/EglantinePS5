+    // and 5.3 MiB as BC3.
+    static const u64 decode_budget = [] {
+        const char* value = std::getenv("EDEN_NX2_TRANSCODE_INFLIGHT_MIB");
+        const u64 mib = value != nullptr ? std::strtoull(value, nullptr, 10) : 192ULL;
+        return (mib != 0 ? mib : 192ULL) << 20;
+    }();
+    static const u64 encode_budget = [] {
+        const char* value = std::getenv("EDEN_NX2_TRANSCODE_CHUNK_MIB");
+        const u64 mib = value != nullptr ? std::strtoull(value, nullptr, 10) : 32ULL;
