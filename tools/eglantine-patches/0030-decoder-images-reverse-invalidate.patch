+    // Drops the texture cache's copy of a decoder image the CPU just wrote. Its device address
+    // comes from the nx2 GPU maps, or else (EglantinePS5 patch 0030) from the SMMU's own reverse
+    // map, page by page: Ocarina of Time's decoder images are reached by no nx2 map (the trace
+    // said mapped=false for every frame), so the GPU kept their first, black, contents.
+    void InvalidateDecoderImage(u64 address, u64 size) {
+        if (const auto device = Nvidia::Devices::Nx2GpuMemoryRegistry::Get().DeviceAddressOf(address)) {
+            system.GPU().InvalidateRegion(*device, size);
+            return;
+        }
+        constexpr u64 PageSize = 0x1000;
+        auto& memory = system.ApplicationMemory();
+        auto& smmu = system.Host1x().MemoryManager();
+        const u64 end = address + size;
+        for (u64 at = address; at < end;) {
+            const u64 chunk = (std::min)(end, (at & ~(PageSize - 1)) + PageSize) - at;
+            if (const u8* const pointer = memory.GetPointer(at);
+                pointer != nullptr && smmu.IsPhysicalPointer(pointer)) {
+                smmu.ApplyOpOnPointer(pointer, m_reverse_scratch, [&](DAddr device) {
+                    if (device >= PageSize) {
+                        system.GPU().InvalidateRegion(device, chunk);
+                    }
+                });
+            }
+            at += chunk;
+        }
+    }
