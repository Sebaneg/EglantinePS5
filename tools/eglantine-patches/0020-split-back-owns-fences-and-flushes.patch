+    /// Runs `func` on the back and waits for it, or at once on the back or without the split: for
+    /// work on back-owned state, such as a buffer cache flush that records a download into the
+    /// Vulkan scheduler, or a fence release. A drained back still submits deferred work from its
+    /// idle hook, so the front must not record into the scheduler itself (zortos293/Lichii
+    /// 12db3f599 and #70; viejunerd/Eglantine-PS5- patches 0049 and 0050).
+    template <typename Func>
+    void RunOnBack(const Func& func) {
+        if (on_back_thread || !active) {
+            func();
+            return;
+        }
+        Defer(func);
+        Drain();
+    }
+    /// Set on the back thread (BackLoop), so that RunOnBack runs there at once.
+    static inline thread_local bool on_back_thread{};
 
